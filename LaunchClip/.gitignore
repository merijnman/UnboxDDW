# Build output. The audio cache lives in build/cache/; share it as a zip,
# but the manifest may be committed so the team sees which takes are current.
build/*
!build/cache/
build/cache/*
!build/cache/manifest.json
dist/
.env

# Assets: artwork and fonts are committed. Music (large, licensed) and
# reference takes downloaded from the ElevenLabs website stay local.
assets/music/
assets/reference/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
